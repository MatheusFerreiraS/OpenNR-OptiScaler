+/* NR record producer (OpenNR, not upstream): NR_ADDR32_HI is a sentinel RADV uses as the 32-bit address high
+ * word; every operand holding it is encoded as m0, which the PAL prologue sets to the real high word. */
+static uint32_t nr_sentinel()
+{
+   static const uint32_t v = getenv("NR_ADDR32_HI") ? (uint32_t)strtoul(getenv("NR_ADDR32_HI"), NULL, 0) : 0;
+   return v;
+}
+static unsigned nr_m0_subst, nr_m0_writes;
+
 void
 emit_instruction(asm_context& ctx, std::vector<uint32_t>& out, Instruction* instr)
 {
+   if (nr_sentinel()) {
+      for (Operand& op : instr->operands) {
+         if (op.isConstant() && op.bytes() == 4 && op.constantValue() == nr_sentinel()) {
+            op = Operand(m0, s1);
+            nr_m0_subst++;
+         }
+      }
+      for (const Definition& d : instr->definitions)
+         if (d.isFixed() && d.physReg() == m0)
+            nr_m0_writes++;
+   }
    /* lower remaining pseudo-instructions */
    if (instr->opcode == aco_opcode::p_constaddr_getpc) {
       ctx.constaddrs[instr->operands[0].constantValue()].getpc_end = out.size() + 1;
@@ -1814,6 +1836,12 @@ emit_program(Program* program, std::vector<uint32_t>& code, std::vector<struct a
 
    fix_branches(ctx, code);
 
+   if (nr_sentinel()) {
+      fprintf(stderr, "NR_M0 subst=%u writes=%u constdata=%u\n", nr_m0_subst, nr_m0_writes,
+              (unsigned)program->constant_data.size());
+      nr_m0_subst = nr_m0_writes = 0;
+   }
+
    unsigned exec_size = code.size() * sizeof(uint32_t);
 
    /* Add end-of-code markers for the UMR disassembler. */
