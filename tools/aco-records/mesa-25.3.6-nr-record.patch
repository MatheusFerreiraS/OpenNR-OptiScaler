+/* NR record producer (OpenNR, not upstream): with NR_RECORD_OUT=<prefix> a compute shader's ACO
+ * binary is written to <prefix>.code and its config and user SGPR layout to <prefix>.txt. */
+static void
+nr_record_dump(const struct radv_device *device, const struct radv_shader_binary *binary,
+               const struct radv_shader_args *args, const struct radv_shader_info *info)
+{
+   const char *prefix = getenv("NR_RECORD_OUT");
+   if (!prefix || !*prefix || info->stage != MESA_SHADER_COMPUTE || binary->type != RADV_BINARY_TYPE_LEGACY)
+      return;
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   struct radv_shader_binary_legacy *bin = (struct radv_shader_binary_legacy *)binary;
+   struct radv_shader_binary_layout layout = radv_shader_binary_get_layout(bin);
+   char path[1024];
+   snprintf(path, sizeof(path), "%s.code", prefix);
+   FILE *f = fopen(path, "wb");
+   if (!f)
+      return;
+   fwrite(layout.code, 1, bin->code_size, f);
+   fclose(f);
+   snprintf(path, sizeof(path), "%s.txt", prefix);
+   f = fopen(path, "w");
+   if (!f)
+      return;
+   const struct ac_shader_config *c = &binary->config;
+   fprintf(f, "family %s\ngfx_level %u\nwave_size %u\n", pdev->info.name, (unsigned)pdev->info.gfx_level,
+           (unsigned)info->wave_size);
+   fprintf(f, "rsrc1 0x%08x\nrsrc2 0x%08x\nrsrc3 0x%08x\n", c->rsrc1, c->rsrc2, c->rsrc3);
+   fprintf(f, "num_vgprs %u\nnum_sgprs %u\nlds_size %u\nscratch_bytes_per_wave %u\nspilled_vgprs %u\nspilled_sgprs %u\n",
+           c->num_vgprs, c->num_sgprs, c->lds_size, c->scratch_bytes_per_wave, c->spilled_vgprs, c->spilled_sgprs);
+   fprintf(f, "float_mode %u\nwgp_mode %u\n", c->float_mode, (unsigned)c->wgp_mode);
+   fprintf(f, "code_size %u\nexec_size %u\n", bin->code_size, bin->exec_size);
+   fprintf(f, "block %u %u %u\n", info->cs.block_size[0], info->cs.block_size[1], info->cs.block_size[2]);
+   fprintf(f, "num_user_sgprs %u\n", args->num_user_sgprs);
+   fprintf(f, "inline_push_const_mask 0x%llx\n", (unsigned long long)args->ac.inline_push_const_mask);
+   fprintf(f, "push_constant_size %u\nloads_push_constants %u\n", info->push_constant_size,
+           (unsigned)info->loads_push_constants);
+   for (unsigned i = 0; i < MAX_SETS; i++)
+      if (args->user_sgprs_locs.descriptor_sets[i].sgpr_idx != -1)
+         fprintf(f, "set %u %d %u\n", i, args->user_sgprs_locs.descriptor_sets[i].sgpr_idx,
+                 (unsigned)args->user_sgprs_locs.descriptor_sets[i].num_sgprs);
+   for (unsigned i = 0; i < AC_UD_MAX_UD; i++)
+      if (args->user_sgprs_locs.shader_data[i].sgpr_idx != -1)
+         fprintf(f, "ud %u %d %u\n", i, args->user_sgprs_locs.shader_data[i].sgpr_idx,
+                 (unsigned)args->user_sgprs_locs.shader_data[i].num_sgprs);
+   fclose(f);
+}
+
 struct radv_shader_binary *
 radv_shader_nir_to_asm(struct radv_device *device, struct radv_shader_stage *pl_stage,
                        struct nir_shader *const *shaders, int shader_count,
@@ -3262,6 +3310,8 @@ radv_shader_nir_to_asm(struct radv_device *device, struct radv_shader_stage *pl_
    struct radv_shader_binary *binary =
       shader_compile(device, shaders, shader_count, stage, info, &pl_stage->args, &pl_stage->key, &options);
 
+   if (binary)
+      nr_record_dump(device, binary, &pl_stage->args, &binary->info);
    return binary;
 }
 
