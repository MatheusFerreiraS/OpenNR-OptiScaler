{ "Producer PSO: %s #%llu, hash 0x%llX, %llu hits (%u candidates)", "Üretici PSO: %s #%llu, hash 0x%llX, %llu isabet (%u aday)" },
{ "Producer PSO: %s #%llu, hash 0x%llX, %llu hits (%u candidates, ambiguous)", "Üretici PSO: %s #%llu, hash 0x%llX, %llu isabet (%u aday, belirsiz)" },
