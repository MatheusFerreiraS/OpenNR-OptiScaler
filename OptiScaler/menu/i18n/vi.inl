{ "Stop tweaking settings and play already", "Thôi chỉnh cài đặt nữa mà chơi đi" },
{ "Stream", "Stream" },
{ "Streamline RR Signal Probe", "Probe tín hiệu RR Streamline" },
{ "Strech edge", "Kéo giãn viền" },
