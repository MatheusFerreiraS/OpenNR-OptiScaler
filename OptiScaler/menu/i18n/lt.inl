{ "Producer PSO: %s #%llu, hash 0x%llX, %llu hits (%u candidates, ambiguous)", "Kūrėjo PSO: %s #%llu, hash 0x%llX, %llu pataikymų (%u kandidatų, dviprasmiška)" },
