{ "Reset to defaults", "Obnovit výchozí" },
{ "Resets Frame generation rectangle", "Resetuje obdélník generování snímků" },
{ "Resistance is futile. Your pixels will be upscaled.", "Odpor je marný. Vaše pixely budou upscalovány." },
{ "Resource", "Zdroj" },
{ "Resource Barriers", "Resource Barriers" },
{ "Resource Blocking", "Blokování zdrojů" },
