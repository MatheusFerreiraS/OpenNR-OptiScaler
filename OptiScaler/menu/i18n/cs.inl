{ "Variance Factor", "Faktor variance" },
{ "Variance factor\nFSR default value: 0.1\nOpti default value: 0.3", "Faktor variance\nVýchozí hodnota FSR: 0.1\nVýchozí hodnota Opti: 0.3" },
{ "Vary noise without motion vectors", "Měnit šum bez pohybových vektorů" },
