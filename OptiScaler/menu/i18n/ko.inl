{ "Producer PSO: %s #%llu, hash 0x%llX, %llu hits (%u candidates)", "생성자 PSO: %s #%llu, 해시 0x%llX, %llu회 적중 (후보 %u개)" },
{ "Producer PSO: %s #%llu, hash 0x%llX, %llu hits (%u candidates, ambiguous)", "생성자 PSO: %s #%llu, 해시 0x%llX, %llu회 적중 (후보 %u개, 모호함)" },
